+    ["backup", "sauvegarde"],
+    ["restore", "restauration", "restaurer"],
+    ["network", "réseau"],
+    ["firewall", "pare-feu"],
+    ["gateway", "passerelle"],
+    ["kubernetes", "k8s"],
+    ["registry", "registre", "dépôt"],
+    ["key", "clé"],
+    ["encryption", "chiffrement"],
+    ["password", "mot de passe"],
+    ["storage", "stockage"],
+    ["load balancer", "répartiteur de charge"],
+    ["ip", "adresse ip"],
+    ["region", "région"],
+    ["availability zone", "zone de disponibilité"],
+    ["tag", "étiquette"],
+    ["user", "utilisateur"],
+    ["role", "rôle"],
+    ["database", "base de données"],
+    ["volume", "disque"],
+    ["access", "accès"],
